views:
  - type: table
    name: Inbox
    filters:
      and:
        - file.inFolder("Inbox")
    order:
      - file.name
      - type
      - tags
      - summary
      - created
  - type: table
    name: Telegram
    filters:
      and:
        - file.inFolder("Telegram")
        - file.ext == "md"
        - '!file.name.startsWith("_")'
    order:
      - file.name
      - type
      - tags
      - summary
      - forwarded_from
      - created
  - type: table
    name: Everything
    filters:
      and:
        - file.ext == "md"
        - '!file.inFolder("Templates")'
        - '!file.inFolder("Daily")'
    order:
      - file.name
      - file.folder
      - type
      - tags
      - created
